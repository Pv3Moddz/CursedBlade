                                local Humanoid = Mob:FindFirstChildOfClass("Humanoid")
                                if HRP and (not Humanoid or Humanoid.Health > 0) then
                                    local dist = (HRP.Position - PlayerHRP.Position).Magnitude
                                    if AutoKillRange == 0 or dist <= AutoKillRange then
                                        local mobCFrame = HRP.CFrame
                                        triggerSkill:FireServer(101, "Enter", mobCFrame, 1)
                                        if FarmDelay then task.wait() end
                                    end
                                end
