		AutoKill = Value
        task.spawn(function()
            while AutoKill do
                local PlayerChar = Player.Character
                if PlayerChar then
                    local PlayerHumanoid = PlayerChar:FindFirstChildOfClass("Humanoid")
                    local PlayerHRP = PlayerChar:FindFirstChild("HumanoidRootPart")
                    local netMessage = PlayerChar:FindFirstChild("NetMessage")
                    local triggerSkill = netMessage and netMessage:FindFirstChild("TrigerSkill")
                    if PlayerHumanoid and PlayerHRP and triggerSkill then
                        local entityFolder = workspace:FindFirstChild("Entity")
                        if entityFolder then
                            for _, Mob in ipairs(entityFolder:GetChildren()) do
                                if not AutoKill then break end
