local LastTick = 0
RunService.Stepped:Connect(function()
	local PlayerChar = Player.Character
	if PlayerChar then
		local PlayerHumanoid = PlayerChar:FindFirstChildOfClass("Humanoid")
		local PlayerHRP = PlayerChar.HumanoidRootPart
		if PlayerHumanoid and PlayerHRP then
			if tick()-LastTick > 0.1 then
				LastTick = tick()
				for _, CurrentPlayer in ipairs(Players:GetChildren()) do
					local CurrentChar = CurrentPlayer.Character
					if CurrentChar then
						if EspHighlight then
							if not CurrentChar:FindFirstChild("PlayerEspHighlight") then
								local PlayerEspHighlight = Instance.new("Highlight")
								PlayerEspHighlight.Name = "PlayerEspHighlight"
								PlayerEspHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
								PlayerEspHighlight.OutlineTransparency = 0.25
								PlayerEspHighlight.FillTransparency = 0.5
								PlayerEspHighlight.Adornee = CurrentChar
								PlayerEspHighlight.Parent = CurrentChar
							end
						else
							local PlayerEspHighlight = CurrentChar:FindFirstChild("PlayerEspHighlight")
							if PlayerEspHighlight then
								PlayerEspHighlight:Destroy()
							end
						end
						if CurrentChar.Head and EspName then
							if CurrentChar:FindFirstChild("PlayerEspName") then
								local Distance = math.floor((PlayerHRP.Position - CurrentChar:FindFirstChild("HumanoidRootPart").Position).Magnitude) or 0
								CurrentChar.PlayerEspName.PlayerEspText.Text = CurrentPlayer.DisplayName.."(@"..CurrentPlayer.Name..") | "..Distance.." Studs"
							else
								local PlayerEspName = Instance.new("BillboardGui")
								PlayerEspName.Name = "PlayerEspName"
								PlayerEspName.Size = UDim2.new(1,0,1,0)
								PlayerEspName.Adornee = CurrentChar.Head
								PlayerEspName.StudsOffset = Vector3.new(0,1.5,0)
								PlayerEspName.AlwaysOnTop = true
								PlayerEspName.Parent = CurrentChar
								local PlayerEspText = Instance.new("TextLabel")
								PlayerEspText.Name = "PlayerEspText"
								PlayerEspText.Parent = PlayerEspName
								PlayerEspText.Size = UDim2.new(1,0,1,0)
								PlayerEspText.BackgroundTransparency = 1
								PlayerEspText.TextColor3 = Color3.new(1, 1, 1)
								PlayerEspText.TextStrokeTransparency = 0
								PlayerEspText.Text = CurrentPlayer.DisplayName.."(@"..CurrentPlayer.Name..") | 0 Studs"
								local PlayerEspTextStroke = Instance.new("UIStroke")
								PlayerEspNameStroke.Parent = PlayerEspText
							end
						else
							local PlayerEspName = CurrentChar:FindFirstChild("PlayerEspName")
							if PlayerEspName then
								PlayerEspName:Destroy()
							end
						end
					end
				end
			end
			if AntiVoid and PlayerHRP.CFrame.Y <= -450 then
				PlayerHRP.CFrame = CFrame.new(PlayerHRP.Position.X, -400, PlayerHRP.Position.Z)
				PlayerHRP.AssemblyLinearVelocity = Vector3.new(PlayerHRP.AssemblyLinearVelocity.X, 0, PlayerHRP.AssemblyLinearVelocity.Z)
			end
		end
		if Fly then
			local bodyVelocity = PlayerHRP:FindFirstChildOfClass("BodyVelocity")
			local bodyGyro = PlayerHRP:FindFirstChildOfClass("BodyGyro")
			if bodyVelocity and bodyGyro then
				PlayerHumanoid.PlatformStand = true
				PlayerHumanoid.AutoRotate = false
				PlayerHRP.AssemblyAngularVelocity = Vector3.zero
				local moveVector = Vector3.zero
				if KeysHeld.W then moveVector = moveVector + Camera.CFrame.LookVector end
				if KeysHeld.S then moveVector = moveVector - Camera.CFrame.LookVector end
				if KeysHeld.D then moveVector = moveVector + Camera.CFrame.RightVector end
				if KeysHeld.A then moveVector = moveVector - Camera.CFrame.RightVector end
				if moveVector.Magnitude > 0 then bodyVelocity.Velocity = moveVector.Unit * PlayerSpeed
				else bodyVelocity.Velocity = Vector3.zero end
				bodyGyro.CFrame = Camera.CFrame
			else
				local bodyVelocity = Instance.new("BodyVelocity")
				bodyVelocity.MaxForce = Vector3.new(999999999, 999999999, 999999999) -- Aplica força APENAS no eixo Y (rotação horizontal)
				bodyVelocity.Velocity = Vector3.zero
				bodyVelocity.Parent = PlayerHRP
				local bodyGyro = Instance.new("BodyGyro")
				bodyGyro.MaxTorque = Vector3.new(999999999, 999999999, 999999999) -- Aplica força APENAS no eixo Y (rotação horizontal)
				bodyGyro.Parent = PlayerHRP
			end
		else
			local bodyVelocity = PlayerHRP:FindFirstChildOfClass("BodyVelocity")
			if bodyVelocity then bodyVelocity:Destroy() end
			local bodyGyro = PlayerHRP:FindFirstChildOfClass("BodyGyro")
			if bodyGyro then bodyGyro:Destroy() end
			PlayerHumanoid.PlatformStand = false
			PlayerHumanoid.AutoRotate = true
			if PlayerSpeed > 0 then PlayerHumanoid.WalkSpeed = PlayerSpeed end
			if JumpHeight > 0 then PlayerHumanoid.JumpHeight = JumpHeight end
			PlayerHumanoid.HipHeight = HipHeight
			if PlayerHumanoid.MoveDirection.Magnitude > 0 and PlayerSpeedMultiplication > 0 then
				PlayerHRP.AssemblyLinearVelocity = PlayerHumanoid.MoveDirection * PlayerHumanoid.WalkSpeed * PlayerSpeedMultiplication + Vector3.new(0, PlayerHRP.AssemblyLinearVelocity.Y, 0)
			end
		end
		if NoClip then
			for _, part in ipairs(PlayerChar:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		else PlayerHRP.CanCollide = true end
	end
end)

